fbf\u8fdb\u884c\u8fdb\u4e00\u6b65\u7684\u8ba1\u7b97\u5206\u6790\u3002</p>"}, {"location": "page/doc/#_18", "title": "\u673a\u68b0\u81c2\u8fd0\u52a8\u5206\u6790", "text": "<p>\u673a\u68b0\u81c2\u8fd0\u52a8\u5206\u6790\u5b9e\u73b0\u5bf9\u673a\u68b0\u81c2\u7269\u7406\u7ed3\u6784\u7684\u62bd\u8c61\u4e0e\u7b80\u5316\uff0c\u65b9\u4fbf\u8fdb\u884c\u8fdb\u4e00\u6b65\u7684\u8ba1\u7b97\u5206\u6790\u3002</p>"}, {"location": "page/doc/#_19", "title": "\u673a\u68b0\u81c2\u89e3\u7b97\u65b9\u6cd5", "text": "<p>\u673a\u68b0\u81c2\u89e3\u7b97\u65b9\u6cd5\u6307\u6839\u636e\u673a\u68b0\u81c2\u7684\u7ed3\u6784\u548c\u8fd0\u52a8\u5b66\u65b9\u7a0b\uff0c\u8ba1\u7b97\u673a\u68b0\u81c2\u7684\u5173\u8282\u89d2\u5ea6\uff0c\u4ece\u800c\u5b9e\u73b0\u673a\u68b0\u81c2\u7684\u8fd0\u52a8\u3002</p>"}, {"location": "page/doc/#_20", "title": "\u673a\u68b0\u81c2\u7684\u8f6f\u4ef6\u63a7\u5236\u4e0e\u6a21\u5757\u5bf9\u63a5", "text": ""}, {"location": "page/doc/#_21", "title": "\u673a\u68b0\u81c2\u63a7\u5236", "text": "<p>\u673a\u68b0\u81c2\u63a7\u5236\u662f\u5229\u7528\u89e3\u7b97\uff0c\u901a\u4fe1\u7b49\u6a21\u5757\uff0c\u5b9e\u73b0\u673a\u68b0\u81c2\u59ff\u6001\u7684\u63a7\u5236\u3002</p>"}, {"location": "page/doc/#_22", "title": "\u673a\u68b0\u81c2\u6a21\u5757\u5bf9\u63a5", "text": "<p>\u673a\u68b0\u81c2\u6a21\u5757\u5bf9\u63a5\u662f\u6307\u5c06\u673a\u68b0\u81c2\u63a7\u5236\u8f6f\u4ef6\u6a21\u5757\u4e0e\u72b6\u6001\u673a\u8fdb\u884c\u5bf9\u63a5\uff0c\u5b9e\u73b0\u673a\u68b0\u81c2\u7684\u63a7\u5236\u3002</p>"}, {"location": "page/doc/#_23", "title": "\u673a\u68b0\u81c2\u7684\u4f7f\u7528\u4e0e\u5f02\u5e38\u5904\u7406", "text": ""}, {"location": "page/doc/#_24", "title": "\u673a\u68b0\u81c2\u7684\u4f7f\u7528", "text": "<p>\u4ecb\u7ecd\u673a\u68b0\u81c2\u7684\u4f7f\u7528\u65b9\u6cd5\uff0c\u5305\u62ec\u673a\u68b0\u81c2\u7684\u5f00\u542f\u3001\u5173\u95ed\u3001\u8fde\u63a5\u7b49\u64cd\u4f5c\u3002</p>"}, {"location": "page/doc/#_25", "title": "\u673a\u68b0\u81c2\u7684\u5f02\u5e38\u5904\u7406", "text": "<p>\u4ecb\u7ecd\u673a\u68b0\u81c2\u5728\u4f7f\u7528\u8fc7\u7a0b\u4e2d\u53ef\u80fd\u51fa\u73b0\u7684\u5f02\u5e38\u60c5\u51b5\uff0c\u4ee5\u53ca\u76f8\u5e94\u7684\u5904\u7406\u65b9\u6cd5\u3002</p>"}, {"location": "page/doc/#_26", "title": "\u5c3e\u58f0", "text": "<p>pass</p>"}, {"location": "page/tutorial/", "title": "\u6559\u7a0b\u5408\u96c6", "text": ""}, {"location": "page/tutorial/#moveit", "title": "MoveIt!", "text": "<p>\u914d\u7f6eURDF</p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/", "title": "URDF \u914d\u7f6e\u8fc7\u7a0b", "text": ""}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#moveit", "title": "\u51c6\u5907 MoveIt! \u73af\u5883", "text": "<p>\u7565</p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_1", "title": "\u521b\u5efa\u5de5\u4f5c\u533a", "text": "<p>\u901a\u8fc7\u4e0b\u9762\u6307\u4ee4\u521b\u5efa ROS \u5de5\u4f5c\u533a</p> <pre><code>mkdir catkin_ws\ncd catkin_ws\nmkdir src\ncatkin_init_workspace\n</code></pre> <p>\u5c06 URDF \u89e3\u538b\u540e\u653e\u7f6e\u5728 <code>src</code> \u4e2d\uff0c\u7f16\u8bd1\u5de5\u4f5c\u7a7a\u95f4</p> <pre><code>cd .. # \u8fd4\u56de catkin_ws \u4e2d\ncatkin_make\n</code></pre> <p><code>source</code> \u5de5\u4f5c\u533a</p> <pre><code>source catkin_ws/devel/setup.bash\n</code></pre>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#moveit_1", "title": "\u542f\u52a8 MoveIt!", "text": "<p>\u6253\u5f00\u7ec8\u7aef\uff0c\u542f\u52a8 <code>moveit_setup_assistant</code> \u529f\u80fd\u5305\uff0c\u5982\u679c\u62a5\u9519\u53ef\u65b0\u5efa\u7ec8\u7aef\u542f\u52a8 <code>roscore</code> \u8282\u70b9</p> <pre><code>rosrun moveit_setup_assistant moveit_setup_assistant\n</code></pre> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#urdf_1", "title": "\u914d\u7f6e URDF", "text": ""}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#urdf_2", "title": "\u6253\u5f00 URDF \u6587\u4ef6", "text": "<p>\u70b9\u51fb\u521b\u5efa\u65b0\u7684\u914d\u7f6e\uff0c\u9009\u62e9 URDF \u540e\u7f00\u6587\u4ef6\uff0c\u901a\u5e38\u5728 <code>./[name]/urdf/[name].urdf</code> .</p> <p></p> <p>\u9009\u62e9\u5b8c\u6210\u540e\uff0c\u70b9\u51fb\u52a0\u8f7d\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_2", "title": "\u751f\u6210\u81ea\u78b0\u649e\u77e9\u9635", "text": "<p>\u9009\u62e9 <code>Self-Collisions</code> \u70b9\u51fb <code>Generate Collision Matr</code>\uff0c\u7b49\u5f85\u6570\u79d2\u5373\u53ef\u3002</p> <p></p> <p>\u5982\u679c\u751f\u6210\u6210\u529f\u5219\u4f1a\u663e\u793a\u4e0b\u9762\u7684\u5185\u5bb9\uff1a</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_3", "title": "\u8bbe\u7f6e/\u865a\u62df\u5173\u8282", "text": "<p>\u9009\u62e9 <code>Virtual Joints</code>\uff0c\u70b9\u51fb <code>Add Virtual Joints</code> \u6dfb\u52a0\u865a\u62df\u5173\u8282\uff08\u975e\u5fc5\u8981\uff09\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_4", "title": "\u6dfb\u52a0\u89c4\u5212\u7ec4", "text": "<p>\u9009\u62e9 <code>Planning Groups</code>\uff0c\u70b9\u51fb <code>Add Group</code>\uff0c\u6dfb\u52a0\u673a\u68b0\u81c2\u89c4\u5212\u7ec4\u3002</p> <p></p> <p>\u8f93\u5165\u89c4\u5212\u7ec4\u540d\u79f0\uff0c\u9009\u62e9\u89e3\u7b97\u5668\u540e\u70b9\u51fb <code>Add Kin. Chain</code>.</p> <p></p> <p>\u4ece\u4e0a\u65b9\u5173\u8282\u4e2d\u9009\u62e9\u673a\u68b0\u81c2\u7684 <code>Top_Link</code> \u548c <code>Base_Link</code>\uff0c\u786e\u5b9a\u540e\u4fdd\u5b58\u9000\u51fa\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_5", "title": "\u8bbe\u7f6e\u673a\u5668\u4eba\u59ff\u6001", "text": "<p>\u9009\u62e9 <code>Roboto Poses</code>\uff0c\u70b9\u51fb <code>Add Pose</code> \u6dfb\u52a0\u673a\u5668\u4eba\u59ff\u6001</p> <p></p> <p>\u8f93\u5165\u59ff\u6001\u540d\u79f0\uff0c\u9009\u62e9\u89c4\u5212\u7ec4\uff0c\u62d6\u52a8\u53f3\u4fa7\u6ed1\u6746\u662f\u673a\u5668\u4eba\u5230\u8fbe\u6307\u5b9a\u59ff\u6001\u540e\u4fdd\u5b58\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_6", "title": "\u8bbe\u7f6e\u672b\u7aef\u6548\u5e94\u5668", "text": "<p>\u9009\u62e9 <code>End Effectors</code>\uff0c\u70b9\u51fb <code>Add End Effector</code> \u6dfb\u52a0\u672b\u7aef\u6548\u5e94\u5668\u3002</p> <p></p> <p>\u8f93\u5165\u540d\u79f0\uff0c\u9009\u62e9\u5bf9\u5e94\u53c2\u6570\u540e\u4fdd\u5b58\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_7", "title": "\u8bbe\u7f6e\u4f5c\u8005\u4fe1\u606f\u5e76\u4fdd\u5b58", "text": "<p>\u70b9\u51fb <code>Author Information</code> \uff0c\u8f93\u5165\u4f5c\u8005\u540d\u79f0\u548c\u90ae\u7bb1\u3002</p> <p></p> <p>\u8bbe\u7f6e URDF \u914d\u7f6e\u4fdd\u5b58\u8def\u5f84\uff0c\u70b9\u51fb <code>Generate Package</code>\uff0c\u7b49\u5f85\u914d\u7f6e\u6587\u4ef6\u751f\u6210\uff0c\u5b8c\u6210\u540e\u70b9\u51fb <code>Exit Setup Assistant</code> \u9000\u51fa\u3002</p> <p></p>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_8", "title": "\u5e38\u89c1\u95ee\u9898", "text": ""}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#_9", "title": "\u5de5\u4f5c\u533a\u5e38\u89c1\u95ee\u9898", "text": "<ol> <li> <p><code>catkin_make</code> \u62a5\u9519\u3002</p> <p>\u8fd4\u56de\u5230\u5de5\u4f5c\u533a\u6839\u76ee\u5f55\u518d\u6b21\u5c1d\u8bd5\u3002</p> </li> <li> <p>\u7f16\u8bd1\u5de5\u4f5c\u533a\u65f6\u62a5\u9519\uff0c\u663e\u793a\u975e\u6cd5\u540d\u79f0\u3002</p> <p>\u8054\u7cfb\u673a\u68b0\u91cd\u65b0\u751f\u6210 URDF \u6587\u4ef6\uff0c\u4fee\u6539\u6587\u4ef6\u540d\u79f0\u3002</p> <p>\u547d\u540d\u8981\u6c42\uff1a</p> <ul> <li>\u4e0d\u80fd\u5305\u542b <code>.</code></li> <li>\u540d\u5b57\u4e0d\u5b9c\u8fc7\u957f</li> </ul> </li> <li> <p>MoveIt! \u6253\u5f00 URDF \u65f6\uff0c\u7ec8\u7aef\u62a5\u9519\u3002</p> <p>\u5173\u95ed\u6240\u6709\u7ec8\u7aef\uff0c\u91cd\u65b0 <code>source</code> \u5de5\u4f5c\u533a\u540e\uff0c\u518d\u6b21\u5c1d\u8bd5\u3002</p> </li> </ol>"}, {"location": "page/tutorial/MoveIt%21/%E9%85%8D%E7%BD%AEURDF/#moveit_2", "title": "MoveIt! \u5e38\u89c1\u95ee\u9898", "text": "<ol> <li> <p>\u5173\u8282\u5217\u8868\u4e3a\u7a7a\u3002</p> <p>\u8054\u7cfb\u673a\u68b0\u91cd\u65b0\u751f\u6210 URDF \u6587\u4ef6\u3002</p> </li> <li> <p>\u8bbe\u7f6e\u59ff\u6001\u65f6\u6ca1\u6709\u53f3\u4fa7\u62c9\u6746\u3002</p> <p>\u5173\u95ed GUI \u754c\u9762\uff0c\u91cd\u65b0\u6253\u5f00\uff0c\u5148\u8fdb\u884c\u81ea\u78b0\u649e\u77e9\u9635\u751f\u6210\uff0c\u7136\u540e\u5728\u8fdb\u884c\u8bbe\u7f6e\u3002</p> </li> <li> <p>\u8bbe\u7f6e\u59ff\u6001\u65f6\u53f3\u4fa7\u62c9\u6746\u65e0\u6cd5\u79fb\u52a8\u3002</p> <p>\u8054\u7cfb\u673a\u68b0\u91cd\u65b0\u751f\u6210 URDF \u6587\u4ef6\uff0c\u4fee\u6539\u5173\u8282\u8f6f\u9650\u4f4d\u3002</p> <p>\u53c2\u8003\u6587\u7ae0\uff1a\u4e3a\u4ec0\u4e48 ROS Moveit setup \u4e2d Define Robot Pose \u680f\u76ee\u4e0b\u6ed1\u6761\u65e0\u6cd5\u62d6\u52a8\uff1f - \u77e5\u4e4e</p> </li> </ol>"}]}